# Copie para .env (raiz, usado pelo docker compose) e/ou services/api/.env (execução local).
# Nunca commite arquivos .env com credenciais reais.

# --- PostgreSQL ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

# --- API (services/api) ---
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
# Lista JSON de origens autorizadas a chamar a API
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
LOG_JSON=true
# Coleta BCB/SGS: janela por requisição (anos, 1–10; limite oficial 10) e intervalo mínimo entre requisições
BCB_DAILY_WINDOW_YEARS=1
BCB_MIN_REQUEST_INTERVAL_SECONDS=0.5
IBGE_SIDRA_BASE_URL=https://apisidra.ibge.gov.br
IBGE_MALHAS_BASE_URL=https://servicodados.ibge.gov.br/api/v3/malhas
# Edição da malha das UFs coletada por `ingest-boundaries` (2022 = a mais recente publicada)
IBGE_MESH_YEAR=2022
IBGE_MIN_REQUEST_INTERVAL_SECONDS=0.5
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# --- Testes de integração (banco descartável; será apagado e recriado) ---
TEST_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas_test

# --- Frontend (apps/web) — usado no build; endereço da API visto pelo navegador ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Coleta automática (serviço `scheduler` do Compose, perfil "scheduler").
# Horários do dia (HH:MM, separados por vírgula) no fuso de Brasília.
INGEST_SCHEDULE=06:00
# true: também coleta assim que o scheduler inicia (útil para preencher um banco novo).
INGEST_ON_START=false
